{
 "rules": {
  "doorbell": {
   "$user": {
    "$other": {
     ".validate": false
    },
    ".read": "auth != null && auth.uid === $user",
    ".validate": "newData.hasChildren(['kind', 'ref', 'ts'])",
    ".write": "auth != null && auth.uid !== $user",
    "kind": {
     ".validate": "newData.isString() && newData.val().length > 0"
    },
    "ref": {
     ".validate": "newData.isString()"
    },
    "ts": {
     ".validate": "newData.isNumber() && newData.val() > 0"
    }
   }
  },
  "presence": {
   "$user": {
    "$other": {
     ".validate": false
    },
    ".validate": "newData.hasChildren(['state', 'ts'])",
    ".write": "auth != null && auth.uid === $user",
    "client_version": {
     ".validate": "newData.isString()"
    },
    "connected_at": {
     ".validate": "newData.isNumber() && newData.val() > 0"
    },
    "state": {
     ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline')"
    },
    "transport": {
     ".validate": "newData.isString()"
    },
    "ts": {
     ".validate": "newData.isNumber() && newData.val() > 0"
    }
   },
   ".read": true
  },
  "liveness": {
   "$user": {
    "$other": {
     ".validate": false
    },
    ".validate": "newData.hasChildren(['grade', 'as_of'])",
    ".write": "auth != null && auth.uid === 'agentlink-server'",
    "grade": {
     ".validate": "newData.isString()"
    },
    "nature_version": {
     ".validate": "newData.isNumber() && newData.val() >= 0"
    },
    "persistence_class": {
     ".validate": "newData.isString()"
    },
    "last_proof_tier": {
     ".validate": "newData.isString()"
    },
    "last_proof_at": {
     ".validate": "newData.isNumber() && newData.val() >= 0"
    },
    "daemon_only": {
     ".validate": "newData.isBoolean()"
    },
    "spec_drift": {
     ".validate": "newData.isBoolean()"
    },
    "nature_compliant": {
     ".validate": "newData.isBoolean()"
    },
    "dossier_status": {
     ".validate": "newData.isString()"
    },
    "build_integrity": {
     ".validate": "newData.isString()"
    },
    "build_version": {
     ".validate": "newData.isString()"
    },
    "build_digest": {
     ".validate": "newData.isString()"
    },
    "as_of": {
     ".validate": "newData.isNumber() && newData.val() > 0"
    }
   },
   ".read": true
  },
  "signals": {
   "$conversation": {
    "$other": {
     ".validate": false
    },
    ".validate": "newData.hasChildren(['latest_item_id', 'counter', 'ts'])",
    ".write": "auth != null",
    "counter": {
     ".validate": "newData.isNumber() && newData.val() >= 0"
    },
    "latest_item_id": {
     ".validate": "newData.isString() && newData.val().length > 0"
    },
    "ts": {
     ".validate": "newData.isNumber() && newData.val() > 0"
    }
   },
   ".read": "auth != null"
  },
  "digest": {
   "$user": {
    "$other": {
     ".validate": false
    },
    ".read": "auth != null",
    ".validate": "newData.hasChildren(['state', 'ts'])",
    ".write": "auth != null && auth.uid === $user",
    "client_version": {
     ".validate": "newData.isString()"
    },
    "state": {
     ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline')"
    },
    "transport": {
     ".validate": "newData.isString()"
    },
    "ts": {
     ".validate": "newData.isNumber() && newData.val() > 0"
    }
   }
  },
  "inbox": {
   "$user": {
    "$item": {
     ".validate": "newData.hasChildren(['frame', 'ts'])",
     ".write": "auth != null && (newData.exists() || auth.uid === $user)",
     "expires_at": {
      ".validate": "newData.isNumber() && newData.val() >= 0"
     },
     "frame": {
      ".validate": "newData.hasChildren(['type', 'id'])"
     },
     "ts": {
      ".validate": "newData.isNumber() && newData.val() > 0"
     },
     "$other": {
      ".validate": false
     }
    },
    ".read": "auth != null && auth.uid === $user"
   }
  },
  "directory": {
   "$user": {
    "$other": {
     ".validate": false
    },
    ".read": "auth != null",
    ".validate": "newData.hasChildren(['username', 'updated_at'])",
    ".write": "auth != null && auth.uid === $user",
    "cap_desc": {
     ".validate": "newData.isString()"
    },
    "designation": {
     ".validate": "newData.isString()"
    },
    "mode": {
     ".validate": "newData.isString()"
    },
    "pubkey": {
     ".validate": "newData.isString()"
    },
    "sign_pub": {
     ".validate": "newData.isString()"
    },
    "updated_at": {
     ".validate": "newData.isNumber() && newData.val() > 0"
    },
    "username": {
     ".validate": "newData.isString() && newData.val().length > 0"
    }
   }
  }
 }
}
